# ==============================================================================
# Abhishek Sahoo Portfolio - Environment Variables
# ==============================================================================

# Port configuration (default: 8000)
PORT=8000

# Groq Cloud API Key (Ultra-fast LPU Inference with Llama 3.3 70B & 3.1 8B)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini API Key (Alternative - generous free quota)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI API Key (Alternative)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional Stripe Integration (for live booking session payments)
# STRIPE_SECRET_KEY=sk_test_...
